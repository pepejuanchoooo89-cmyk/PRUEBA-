-- ══════════════════════════════════════════
--  HELPERS
-- ══════════════════════════════════════════
local function getHRP(p)
    local c = p and p.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum(p)
    local c = p and p.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function w2s(pos)
    local s, vis = Cam:WorldToViewportPoint(pos)
    return Vector2.new(s.X, s.Y), vis, s.Z
end

local function screenCenter()
    return Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
end

-- Runtime path resolver — finds egg/key/powerup folders without static names
local ITEM_TAGS = { egg = "Egg", key = "Key", powerup = "PowerUp" }

local function resolveItemFolders()
    local found = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local n = obj.Name:lower()
        for tag, label in pairs(ITEM_TAGS) do
            if n:find(tag) and obj:IsA("Folder") or obj:IsA("Model") then
                found[label] = found[label] or {}
                table.insert(found[label], obj)
            end
        end
    end
    return found
end

-- ══════════════════════════════════════════
--  DRAWING POOL
-- ══════════════════════════════════════════
local pool = {}

local function mkText(sz, col)
    local d = Drawing.new("Text")
    d.Visible = false; d.Size = sz or 13
    d.Font = Drawing.Fonts.UI; d.Outline = true
    d.Center = true; d.Color = col or Color3.new(1,1,1)
    return d
end

local function mkLine(col, thick)
    local d = Drawing.new("Line")
    d.Visible = false
    d.Color = col or Color3.new(1,1,1)
    d.Thickness = thick or CFG.ESP.Thickness
    return d
end

local function mkQuad(col, thick)
    local d = Drawing.new("Quad")
    d.Visible = false; d.Filled = false
    d.Color = col or Color3.new(1,1,1)
    d.Thickness = thick or CFG.ESP.Thickness
    return d
end

local function mkRect(col)
    local d = Drawing.new("Square")
    d.Visible = false; d.Filled = true
    d.Color = col or Color3.fromRGB(80,255,80)
    return d
end

local function ensurePlayer(p)
    if not pool[p] then
        local c = CFG.ESP.Colors.Player
        pool[p] = {
            name    = mkText(13, c),
            dist    = mkText(11, Color3.fromRGB(210,210,210)),
            box     = mkQuad(c, CFG.ESP.Thickness),
            hpBg    = mkRect(Color3.fromRGB(60,60,60)),
            hpFill  = mkRect(CFG.ESP.Colors.Health),
            -- skeleton: 6 limb lines
            limbs   = { mkLine(c), mkLine(c), mkLine(c), mkLine(c), mkLine(c), mkLine(c) },
        }
    end
    return pool[p]
end

local itemPool = {}  -- [part] = { label }

local function ensureItem(part, label, col)
    if not itemPool[part] then
        itemPool[part] = { lbl = mkText(12, col) }
    end
    return itemPool[part]
end

local function wipePlayer(p)
    local e = pool[p]; if not e then return end
    for k, v in pairs(e) do
        if type(v) == "table" then for _, d in ipairs(v) do d:Remove() end
        else v:Remove() end
    end
    pool[p] = nil
end

Players.PlayerRemoving:Connect(wipePlayer)

-- ══════════════════════════════════════════
--  SKELETON BONE PAIRS (R6 / R15 adaptive)
-- ══════════════════════════════════════════
local R6_BONES = {
    {"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},
    {"Torso","Left Leg"},{"Torso","Right Leg"},{"Head","HumanoidRootPart"},
}
local R15_BONES = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"UpperTorso","RightUpperArm"},
    {"LowerTorso","LeftUpperLeg"},{"LowerTorso","RightUpperLeg"},
}

local function getBones(char)
    if char:FindFirstChild("UpperTorso") then return R15_BONES else return R6_BONES end
end

local function drawSkeleton(char, limbs, vis)
    local bones = getBones(char)
    for i, pair in ipairs(bones) do
        local l = limbs[i]
        if not l then continue end
        local a = char:FindFirstChild(pair[1])
        local b = char:FindFirstChild(pair[2])
        if a and b then
            local sa, va = w2s(a.Position)
            local sb, vb = w2s(b.Position)
            l.From    = sa; l.To = sb
            l.Visible = vis and va and vb and CFG.ESP.Skeleton
        else
            l.Visible = false
        end
    end
end

