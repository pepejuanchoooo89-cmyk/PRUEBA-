-- ══════════════════════════════════════════
--  AUTO-FARM (pathfinding → nearest egg)
-- ══════════════════════════════════════════
local lastTp = 0

task.spawn(function()
    while task.wait(0.15) do
        if not CFG.Farm.AutoCollect then continue end
        local myHRP = getHRP(LP); if not myHRP then continue end

        local folders = resolveItemFolders()
        local eggFolders = folders["Egg"] or {}

        local closest, closestDist = nil, math.huge
        for _, folder in ipairs(eggFolders) do
            for _, item in ipairs(folder:GetChildren()) do
                local part = item:FindFirstChildWhichIsA("BasePart") or
                             (item:IsA("BasePart") and item)
                if not part then continue end
                local d = (myHRP.Position - part.Position).Magnitude
                if d < closestDist then closestDist = d; closest = part end
            end
        end

        if not closest then continue end

        if CFG.Farm.Teleport then
            local now = tick()
            if now - lastTp >= CFG.Farm.TpCooldown then
                myHRP.CFrame = CFrame.new(closest.Position + Vector3.new(0, 3, 0))
                lastTp = now
            end
        else
            -- pathfind walk
            local path = PathfindingService:CreatePath({
                AgentRadius       = 2,
                AgentHeight       = 5,
                AgentCanJump      = true,
                AgentMaxSlope     = 45,
            })
            local ok = pcall(function() path:ComputeAsync(myHRP.Position, closest.Position) end)
            if ok and path.Status == Enum.PathStatus.Success then
                for _, wp in ipairs(path:GetWaypoints()) do
                    if not CFG.Farm.AutoCollect then break end
                    local hum = getHum(LP); if not hum then break end
                    if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
                    hum:MoveTo(wp.Position)
                    hum.MoveToFinished:Wait()
                end
            end
        end
    end
end)

