-- ══════════════════════════════════════════
--  AIMBOT
-- ══════════════════════════════════════════
local function getBestTarget()
    local myHRP  = getHRP(LP)
    if not myHRP then return nil end
    local center = screenCenter()

    local best, bestScore = nil, math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local hrp = getHRP(p)
        local hum = getHum(p)
        if not hrp or not hum or hum.Health <= 0 then continue end

        local targetPos = hrp.Position + Vector3.new(0, 1.5, 0)

        -- prediction: lead by velocity * PredictMs
        if CFG.Aimbot.Prediction then
            local vel = hrp.AssemblyLinearVelocity
            targetPos = targetPos + vel * (CFG.Aimbot.PredictMs / 1000)
        end

        local sp, vis = w2s(targetPos)
        if not vis then continue end

        local dist3D  = (myHRP.Position - hrp.Position).Magnitude
        local distFOV = (sp - center).Magnitude

        if distFOV > CFG.Aimbot.FOV then continue end

        local score
        if     CFG.Aimbot.Mode == "Closest"   then score = dist3D
        elseif CFG.Aimbot.Mode == "LowestHP"  then score = hum.Health
        elseif CFG.Aimbot.Mode == "Crosshair" then score = distFOV
        else   score = dist3D end

        if score < bestScore then bestScore = score; best = { hrp = hrp, pos = targetPos } end
    end
    return best
end

RunService.RenderStepped:Connect(function()
    if not CFG.Aimbot.Enabled then return end
    local t = getBestTarget()
    if not t then return end
    local goal = CFrame.new(Cam.CFrame.Position, t.pos)
    Cam.CFrame  = Cam.CFrame:Lerp(goal, CFG.Aimbot.Smoothness)
end)

