RunService.RenderStepped:Connect(function()
    local myHRP = getHRP(LP)
    local vp    = Cam.ViewportSize

    -- ── Player ESP ──
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local hrp = getHRP(p)
        local hum = getHum(p)
        if not hrp then wipePlayer(p); continue end

        local dist = myHRP and (myHRP.Position - hrp.Position).Magnitude or 0
        local e    = ensurePlayer(p)

        if not CFG.ESP.Enabled or dist > CFG.ESP.MaxDist then
            for k, v in pairs(e) do
                if type(v) == "table" then for _, d in ipairs(v) do d.Visible = false end
                else v.Visible = false end
            end
            continue
        end

        local top, topVis = w2s(hrp.Position + Vector3.new(0, 3.5, 0))
        local bot, botVis = w2s(hrp.Position + Vector3.new(0, -3,  0))
        local onScreen    = topVis and botVis

        -- Box
        if CFG.ESP.Boxes and onScreen then
            local h  = math.abs(top.Y - bot.Y)
            local w  = h * 0.6
            e.box.PointA = top + Vector2.new(-w/2, 0)
            e.box.PointB = top + Vector2.new( w/2, 0)
            e.box.PointC = bot + Vector2.new( w/2, 0)
            e.box.PointD = bot + Vector2.new(-w/2, 0)
            e.box.Color  = CFG.ESP.Colors.Player
            e.box.Visible = true
        else e.box.Visible = false end

        -- Name
        e.name.Text     = p.DisplayName
        e.name.Position = top + Vector2.new(0, -16)
        e.name.Visible  = onScreen and CFG.ESP.Names

        -- Distance
        e.dist.Text     = math.floor(dist) .. " st"
        e.dist.Position = bot + Vector2.new(0, 4)
        e.dist.Visible  = onScreen and CFG.ESP.Distance

        -- Health Bar
        if hum and CFG.ESP.HealthBar and onScreen then
            local h   = math.abs(top.Y - bot.Y)
            local w   = h * 0.6
            local barX = (top.X - w/2) - 6
            local pct  = hum.Health / hum.MaxHealth
            e.hpBg.Size     = Vector2.new(4, h)
            e.hpBg.Position = Vector2.new(barX, top.Y)
            e.hpBg.Visible  = true
            e.hpFill.Size     = Vector2.new(4, h * pct)
            e.hpFill.Position = Vector2.new(barX, top.Y + h * (1 - pct))
            e.hpFill.Color    = Color3.fromRGB(
                math.floor(255 * (1 - pct)), math.floor(255 * pct), 50)
            e.hpFill.Visible  = true
        else
            e.hpBg.Visible = false; e.hpFill.Visible = false
        end

        -- Skeleton
        if CFG.ESP.Skeleton and onScreen then
            drawSkeleton(p.Character, e.limbs, true)
        else
            for _, l in ipairs(e.limbs) do l.Visible = false end
        end
    end

    -- ── Item ESP ──
    if CFG.ESP.Items then
        local folders = resolveItemFolders()
        for label, col in pairs({
            Egg = CFG.ESP.Colors.Egg,
            Key = CFG.ESP.Colors.Key,
            PowerUp = CFG.ESP.Colors.PowerUp,
        }) do
            local flist = folders[label] or {}
            for _, folder in ipairs(flist) do
                for _, item in ipairs(folder:GetChildren()) do
                    local part = item:FindFirstChildWhichIsA("BasePart") or
                                 (item:IsA("BasePart") and item)
                    if not part then continue end
                    local sp, vis = w2s(part.Position)
                    local dist2   = myHRP and (myHRP.Position - part.Position).Magnitude or 0
                    local e2      = ensureItem(part, label, col)
                    e2.lbl.Text     = label .. " [" .. math.floor(dist2) .. "]"
                    e2.lbl.Position = sp + Vector2.new(0, -10)
                    e2.lbl.Color    = col
                    e2.lbl.Visible  = vis and dist2 < CFG.ESP.MaxDist
                end
            end
        end
    end
end)

